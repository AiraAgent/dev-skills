#!/usr/bin/env bash
# The run marker: the file that says a run is in progress, which plan it is
# executing, and what commit it started from.
#
# It lives with the rest of that run's artifacts, at
# <repo-root>/.ai-workflow/run/<plan-basename>/RUN — briefs, reports, review
# packages and the marker in one directory, so removing a plan's directory
# removes its marker with it and nothing is left stranded at the top level.
#
# Three consumers:
#   dev-skills:implement  writes it once the workspace is settled
#   dev-skills:finish     reads the base off it, and clears it after proven integration
#   finish-guard          arms itself only while one exists
#
# In a worktree .ai-workflow is a symlink into the main checkout, so both trees
# see the same marker — which is what makes "one run at a time in this
# repository" true rather than hoped for. `begin` enforces that: any existing
# marker, for any plan, refuses a second run.
#
# A marker left behind by an abandoned run keeps finish-guard armed. That is the
# intended failure direction: visible, and cleared with `run-state end`.
#
# Usage: run-state begin PLAN_FILE BASE | run-state show | run-state end
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
root=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "not a git repository" >&2; exit 2; }
runs="$root/.ai-workflow/run"

# Every marker in this repository, one path per line. Empty output means no run.
find_markers() {
  [ -d "$runs" ] || return 0
  find "$runs" -mindepth 2 -maxdepth 2 -name RUN -type f 2>/dev/null | LC_ALL=C sort
}

case "${1:-}" in
  begin)
    [ $# -eq 3 ] || { echo "usage: run-state begin PLAN_FILE BASE" >&2; exit 2; }
    plan=$2
    base=$3
    [ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }
    git rev-parse --verify --quiet "$base" >/dev/null || { echo "bad BASE: $base" >&2; exit 2; }

    existing="$(find_markers)"
    if [ -n "$existing" ]; then
      echo "a run is already in progress in this repository:" >&2
      printf '%s\n' "$existing" | while IFS= read -r m; do sed 's/^/  /' "$m" >&2; done
      echo "finish it with dev-skills:finish, or clear it with 'run-state end'" >&2
      exit 3
    fi

    dir="$("$here/workspace" "$plan")"
    {
      echo "plan=$plan"
      echo "base=$(git rev-parse "$base")"
      echo "branch=$(git rev-parse --abbrev-ref HEAD)"
      echo "tree=$root"
      echo "started=$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    } > "$dir/RUN"
    echo "run started: $plan"
    echo "marker: $dir/RUN"
    ;;

  show)
    markers="$(find_markers)"
    [ -n "$markers" ] || { echo "no run in progress" >&2; exit 1; }
    printf '%s\n' "$markers" | while IFS= read -r m; do
      echo "# $m"
      cat "$m"
    done
    ;;

  end)
    markers="$(find_markers)"
    [ -n "$markers" ] || { echo "no run in progress" >&2; exit 1; }
    printf '%s\n' "$markers" | while IFS= read -r m; do
      rm "$m"
      echo "cleared $m"
    done
    ;;

  *)
    echo "usage: run-state begin PLAN_FILE BASE | run-state show | run-state end" >&2
    exit 2
    ;;
esac
