#!/usr/bin/env bash
# Resolve and ensure the directory one run keeps its short-lived artifacts in:
# segment briefs, implementer reports, review packages. Print its absolute path.
#
# One directory per plan (.ai-workflow/run/<plan-basename>/) so a later plan in
# the same working tree can never read or overwrite another plan's artifacts.
#
# .ai-workflow lives in the working tree rather than under .git/ because agent
# harnesses treat .git/ as protected and deny writes there — which would stop an
# implementer subagent from writing its report. Keeping the whole tree out of
# git is the repository .gitignore's job, and this script makes sure the line is
# there: **without a trailing slash**, because in a worktree .ai-workflow is a
# symlink and git sees a symlink as a file, which a trailing-slash pattern does
# not match.
#
# Single source of truth for the location, so the other scripts cannot drift to
# a different directory.
#
# Usage: workspace PLAN_FILE
set -euo pipefail

if [ $# -ne 1 ]; then
  echo "usage: workspace PLAN_FILE" >&2
  exit 2
fi

plan=$1
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

slug=$(basename "$plan" .md)
[ -n "$slug" ] && [ "$slug" != "." ] && [ "$slug" != ".." ] \
  || { echo "cannot derive a workspace name from: $plan" >&2; exit 2; }

root=$(git rev-parse --show-toplevel)
ignore="$root/.gitignore"
if [ ! -f "$ignore" ] || ! grep -qxF '.ai-workflow' "$ignore"; then
  printf '.ai-workflow\n' >> "$ignore"
fi

dir="$root/.ai-workflow/run/$slug"
mkdir -p "$dir"
cd "$dir" && pwd
