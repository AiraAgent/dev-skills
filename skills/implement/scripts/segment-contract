#!/usr/bin/env bash
# Assemble a segment's output contract: the union of the "Frozen for later
# phases" fields of its phases. Print it, or write it to a file.
#
# This is what a checkpoint reviewer may not change with an ordinary finding —
# later phases have already been briefed against these names, signatures and
# shapes, so renaming one leaves the next implementer hunting for an abstraction
# that no longer exists. Needing one changed is a PLAN_CONFLICT, not a finding.
#
# Nothing extra is written in the plan for this: the contract is derived from
# fields the phases carry anyway. A separate section would be a second copy and
# would diverge at the first correction.
#
# With --built, also assembles what earlier segments actually built: every
# `## Divergences` section (a report may carry more than one — fix rounds
# append) from each segment-*-report.md in the run's workspace, attributed to
# its file. A report with none of that heading is reported as unknown, not as
# clean — an omitted section and an empty one must never read alike. Without
# --built, output is exactly as before.
#
# Usage: segment-contract [--built] PLAN_FILE RANGE [OUTFILE]
#   RANGE   a single phase (3) or an inclusive span (2-4)
set -euo pipefail

built=0
if [ "${1:-}" = "--built" ]; then
  built=1
  shift
fi

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: segment-contract [--built] PLAN_FILE RANGE [OUTFILE]" >&2
  exit 2
fi

plan=$1
range=$2
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

case "$range" in
  *[0-9]-[0-9]*) first=${range%%-*}; last=${range##*-} ;;
  *[!0-9]*)      echo "bad RANGE: $range (want 3 or 2-4)" >&2; exit 2 ;;
  *)             first=$range; last=$range ;;
esac
[ "$first" -le "$last" ] 2>/dev/null || { echo "bad RANGE: $range" >&2; exit 2; }

body=$(awk -v first="$first" -v last="$last" '
  /^```/ { fence = !fence }

  !fence && /^###[ \t]+Phase[ \t]+[0-9]+/ {
    n = $0; sub(/^###[ \t]+Phase[ \t]+/, "", n); sub(/[^0-9].*$/, "", n)
    inseg = (n + 0 >= first && n + 0 <= last)
    title = $0; sub(/^###[ \t]+/, "", title)
    infield = 0
    next
  }

  !fence && /^\*\*[A-Z]/ {
    infield = (inseg && $0 ~ /^\*\*Frozen for later phases\*\*/)
    if (infield) printed_title = 0
    next
  }

  infield {
    if ($0 ~ /^[ \t]*$/) next
    if ($0 ~ /^[ \t]*-[ \t]*—[ \t]*$/) next
    if (!printed_title) { print "## " title; printed_title = 1 }
    print
  }
' "$plan")

if [ -z "$body" ]; then
  body="No phase in ${first}-${last} freezes anything for later phases.
Nothing in this segment is off limits to ordinary findings."
fi

out_text="# Output contract — phases ${first}-${last}

Names, signatures and data shapes that later phases were briefed against. A
review may not change these with an ordinary finding; needing one changed is a
PLAN_CONFLICT and escalates.

${body}"

if [ "$built" -eq 1 ]; then
  ws_script="$(cd "$(dirname "$0")" && pwd)/workspace"
  dir=$("$ws_script" "$plan") || {
    echo "segment-contract --built: could not resolve the run workspace for $plan" >&2
    exit 1
  }

  reports=()
  for f in "$dir"/segment-*-report.md; do
    [ -e "$f" ] || continue
    reports+=("$f")
  done

  if [ "${#reports[@]}" -gt 0 ]; then
    sorted=()
    while IFS= read -r f; do
      sorted+=("$f")
    done < <(
      for f in "${reports[@]}"; do
        n=$(basename "$f" | sed -E 's/^segment-([0-9]+)-report\.md$/\1/')
        printf '%s\t%s\n' "$n" "$f"
      done | LC_ALL=C sort -n -k1,1 | cut -f2-
    )
    reports=("${sorted[@]}")
  fi

  if [ "${#reports[@]}" -eq 0 ]; then
    built_text="# What earlier segments actually built

Workspace: ${dir}
Reports read: none — the workspace resolved cleanly and holds no
\`segment-*-report.md\` file. That is the legitimate answer for the first
segment: nothing precedes it. This is derived from an empty workspace, not
from a failed lookup."
  else
    names=""
    for f in "${reports[@]}"; do
      b=$(basename "$f")
      names="${names}${names:+, }${b}"
    done

    built_text="# What earlier segments actually built

Workspace: ${dir}
Reports read, in sorted order: ${names}."

    for f in "${reports[@]}"; do
      base=$(basename "$f")
      [ -r "$f" ] || {
        echo "segment-contract --built: cannot read $f" >&2
        exit 1
      }

      chunk=$(awk '
        /^```/ { fence = !fence; if (grab) print; next }
        !fence && /^##[ \t]+Divergences[ \t]*$/ {
          if (found) { print ""; print "---"; print "" }
          grab = 1; found = 1
          print "### Divergences"
          next
        }
        !fence && grab && /^#{1,2}[ \t]/ { grab = 0 }
        grab { print }
        END { exit(found ? 0 : 1) }
      ' "$f") && rc=0 || rc=$?

      if [ "$rc" -eq 0 ]; then
        block="## ${base}

${chunk}"
      else
        block="## ${base}

\`${base}\` carries no \`## Divergences\` section; what it diverged on is not recorded."
      fi

      built_text="${built_text}

${block}"
    done
  fi

  out_text="${out_text}

${built_text}"
fi

if [ $# -eq 3 ]; then
  printf '%s\n' "$out_text" > "$3"
  echo "wrote $3"
else
  printf '%s\n' "$out_text"
fi
