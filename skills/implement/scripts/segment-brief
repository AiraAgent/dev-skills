#!/usr/bin/env bash
# Cut one segment out of a plan into the file its implementer reads in a single
# call, so plan text never passes through the orchestrator's context.
#
# A brief is the plan's header (everything above "## Phases") plus the phases of
# this segment, verbatim. Other phases are deliberately left out: they fill a
# weak model's context and invite work outside its bounds. What is shared lives
# in the header, in one copy.
#
# "## Phases" and the phase subheadings are fixed strings for exactly this reason
# — the cut is mechanical and needs stable anchors.
#
# The "## Phases" line is checked before anything is cut. Without it the awk
# below never leaves header mode: it emits the whole plan, swallowing every phase
# heading outside the range while still printing their bodies. Both of the checks
# at the bottom pass on that output, so the failure is silent and the implementer
# receives its own phase followed by unlabelled requirement blocks it cannot
# attribute. That is worth a hard stop, not a warning.
#
# Usage: segment-brief PLAN_FILE RANGE [OUTFILE]
#   RANGE   a single phase (3) or an inclusive span (2-4)
# Default OUTFILE: <workspace>/segment-<range>-brief.md
set -euo pipefail

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: segment-brief PLAN_FILE RANGE [OUTFILE]" >&2
  exit 2
fi

plan=$1
range=$2
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

grep -qE '^##[ \t]+Phases[ \t]*$' "$plan" || {
  echo "no '## Phases' heading in ${plan}" >&2
  echo "the cut anchors on it; without it the brief would be the whole plan" >&2
  exit 2
}

case "$range" in
  *[0-9]-[0-9]*) first=${range%%-*}; last=${range##*-} ;;
  *[!0-9]*)      echo "bad RANGE: $range (want 3 or 2-4)" >&2; exit 2 ;;
  *)             first=$range; last=$range ;;
esac
[ "$first" -le "$last" ] 2>/dev/null || { echo "bad RANGE: $range" >&2; exit 2; }

if [ $# -eq 3 ]; then
  out=$3
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/workspace" "$plan")
  out="$dir/segment-${first}-${last}-brief.md"
fi

# Once "## Phases" ends — at the next real "##" heading — the cut latches
# closed: inphases drops to 0 and nothing later can reopen it, whatever it
# looks like. Without the latch, a "###" subheading of a trailing section
# (e.g. "## Decisions taken during execution") that happens to start with
# "Phase <digits>" satisfies the phase-heading rule below and reopens the cut,
# dragging that section's body into the brief. The phase-heading regex is
# tightened too, requiring "." or whitespace right after the number, so
# "Phase 8's ..." cannot match it while "Phase 8." and "Phase 10." still do —
# belt and braces, since either fix alone closes the bug on its own.
awk -v first="$first" -v last="$last" '
  /^```/ { fence = !fence }
  fence { if (emit || header) print; next }

  /^##[ \t]+Phases[ \t]*$/ { inphases = 1; header = 0; next }

  # Anything after the phases that is not a phase heading ends the cut for good.
  inphases && /^##[ \t]+/ { inphases = 0; emit = 0; next }

  # A phase heading decides whether the following lines belong to this segment.
  inphases && /^###[ \t]+Phase[ \t]+[0-9]+[.[:space:]]/ {
    n = $0; sub(/^###[ \t]+Phase[ \t]+/, "", n); sub(/[^0-9].*$/, "", n)
    emit = (n + 0 >= first && n + 0 <= last)
    if (emit) print
    next
  }

  header { print; next }
  emit { print }

  BEGIN { header = 1 }
' "$plan" > "$out"

found=$(grep -cE '^###[ \t]+Phase[ \t]+' "$out" || true)
if [ "$found" -eq 0 ]; then
  echo "no phase in range ${first}-${last} found in ${plan}" >&2
  exit 3
fi

want=$((last - first + 1))
if [ "$found" -ne "$want" ]; then
  echo "warning: range ${first}-${last} wanted ${want} phases, the brief carries ${found}" >&2
fi

missing=""
for field in "Becomes true" "Changes" "How" "Do not touch" \
             "Frozen for later phases" "Verification" "Steps"; do
  grep -qF "**${field}**" "$out" || missing="${missing}${missing:+, }${field}"
done
if [ -n "$missing" ]; then
  echo "warning: no phase in this brief carries: ${missing}" >&2
fi

echo "wrote ${out}: $(wc -l < "$out" | tr -d ' ') lines"
